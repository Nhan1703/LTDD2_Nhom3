{
  "version": 2,
  "rewrites": [
    { "source": "/swagger", "destination": "/swagger.html" },
    { "source": "/swagger.html", "destination": "/swagger.html" },
    { "source": "/openapi.json", "destination": "/openapi.json" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/swagger.html" }
  ]
}
